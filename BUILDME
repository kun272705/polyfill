#!/usr/bin/env bash

set -euo pipefail

if [[ -f src/polyfill.js ]]; then

  printf "Building src/polyfill.js\n"

  mkdir -p dst/

  npx swc src/polyfill.js -o dst/polyfill.optimized.js

  npx rolldown dst/polyfill.optimized.js -o dst/polyfill.combined.js -f iife

  if [[ "${MODE:-development}" == production ]]; then

    npx terser dst/polyfill.combined.js -c -o dst/polyfill.js

  else

    cp dst/polyfill.combined.js dst/polyfill.js

  fi

  rm dst/polyfill.optimized.js
  rm dst/polyfill.combined.js

fi

printf "Done\n"

